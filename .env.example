# Copy to .env for local development. Never commit the real .env file.
PORT=3000
NODE_ENV=development

# Site and campus details
SITE_NAME=EventEase
CAMPUS_NAME=colleges in Coimbatore
CAMPUS_CITY=Coimbatore
CAMPUS_LAT=11.0168
CAMPUS_LON=76.9558
CAMPUS_TIMEZONE=Asia/Kolkata

# Builder details shown in the footer and About page
SITE_OWNER_NAME=Your Name
SITE_OWNER_EMAIL=you@example.com
GITHUB_USERNAME=octocat

# PostgreSQL (FAQs, error codes, support tickets).
# Leave empty locally to use the embedded PGlite database in ./data/pglite.
DATABASE_URL=

# MongoDB (chat logs and feedback). Leave empty locally to use an in-memory store.
MONGODB_URI=
MONGODB_DB=helpdesk

# AI assistant: set ONE of these. Gemini has a free tier (key from https://aistudio.google.com/apikey).
# Without a key the assistant runs in rule-based fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BACKUP_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=15000

# Booking emails via Brevo (free: https://www.brevo.com). MAIL_FROM must be a verified sender.
BREVO_API_KEY=
MAIL_FROM=

# Third-party API (Open-Meteo weather) time limit
WEATHER_TIMEOUT_MS=3000

# Token for the /admin organiser dashboard and admin API (long random string)
ADMIN_TOKEN=change-me-to-a-long-random-string
