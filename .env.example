# Copy to .env for local development. Never commit the real .env file.
PORT=3000
NODE_ENV=development

# Personalise the site
SITE_OWNER_NAME=Your Name
SITE_OWNER_ROLE=Software Development Student
SITE_OWNER_EMAIL=you@example.com
GITHUB_USERNAME=octocat

# PostgreSQL (FAQs, error codes, support tickets).
# Leave empty locally to use the embedded PGlite database in ./data/pglite.
DATABASE_URL=

# MongoDB (chat logs and feedback). Leave empty locally to use an in-memory store.
MONGODB_URI=
MONGODB_DB=helpdesk

# Claude API (AI assistant). Without a key the assistant runs in rule-based fallback mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=15000

# Third-party API (GitHub) time limit
GITHUB_TIMEOUT_MS=3000

# Token for the /admin ticket dashboard and admin API (long random string)
ADMIN_TOKEN=change-me-to-a-long-random-string
